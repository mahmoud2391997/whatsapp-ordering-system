generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Products ───────────────────────────────────────────────────────

model Product {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  nameAr          String   @map("name_ar")
  category        String   @default("vegetables")
  unit            String   @default("kg")
  retailPrice     Decimal  @default(0) @db.Decimal(10, 2) @map("retail_price")
  shopPrice       Decimal  @default(0) @db.Decimal(10, 2) @map("shop_price")
  wholesalePrice  Decimal  @default(0) @db.Decimal(10, 2) @map("wholesale_price")
  stock           Int      @default(0)
  imageUrl        String   @map("image_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  orderItems OrderItem[]

  @@map("products")
}

// ─── Customers ──────────────────────────────────────────────────────

model Customer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  phone        String   @unique
  type         String   @default("retail")
  location     String?
  totalOrders  Int      @default(0) @map("total_orders")
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Date

  orders Order[]

  @@map("customers")
}

// ─── Orders ─────────────────────────────────────────────────────────

model Order {
  id             String    @id // text, e.g. "ORD-001"
  customerId     String?   @map("customer_id") @db.Uuid
  customerName   String    @map("customer_name")
  customerType   String    @default("retail") @map("customer_type")
  total          Decimal   @default(0) @db.Decimal(10, 2)
  status         String    @default("pending")
  paymentStatus  String    @default("unpaid") @map("payment_status")
  location       String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  menuPageId     String?   @map("menu_page_id") @db.Uuid

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  menuPage   MenuPage? @relation(fields: [menuPageId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  transactions Transaction[]

  @@index([status])
  @@index([customerId])
  @@index([menuPageId])
  @@map("orders")
}

// ─── Order Items ────────────────────────────────────────────────────

model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id")
  productId   String? @map("product_id") @db.Uuid
  productName String  @map("product_name")
  qty         Decimal @db.Decimal(10, 2)
  unit        String  @default("kg")
  unitPrice   Decimal @default(0) @db.Decimal(10, 2) @map("unit_price")

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ─── Conversations ──────────────────────────────────────────────────

model Conversation {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerName  String  @map("customer_name")
  phone         String
  customerType  String  @default("retail") @map("customer_type")
  status        String  @default("active")
  orderId       String? @map("order_id")
  lastActivity  String  @default("") @map("last_activity")

  messages Message[]

  @@map("conversations")
}

// ─── Messages ───────────────────────────────────────────────────────

model Message {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String  @map("conversation_id") @db.Uuid
  sender         String  @default("customer")
  text           String
  time           String
  type           String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ─── Menu Pages ─────────────────────────────────────────────────────

model MenuPage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique
  customerName  String   @map("customer_name")
  phone         String
  customerType  String   @default("retail") @map("customer_type")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  orders Order[]

  @@index([slug])
  @@map("menu_pages")
}

// ─── Transactions ───────────────────────────────────────────────────

model Transaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String?  @map("order_id")
  amount           Decimal  @default(0) @db.Decimal(12, 2)
  currency         String   @default("SAR")
  status           String   @default("pending")
  paymentMethod    String?  @map("payment_method")
  providerId       String?  @map("provider_id")
  providerResponse Json?    @map("provider_response")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([providerId])
  @@map("transactions")
}

// ─── Webhook Events ─────────────────────────────────────────────────

model WebhookEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source    String   @default("system")
  eventType String   @default("unknown") @map("event_type")
  payload   Json     @default("{}")
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([source])
  @@index([processed])
  @@index([createdAt(sort: Desc)])
  @@map("webhook_events")
}

// ─── System Logs ────────────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     String   @default("info")
  service   String   @default("system")
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([service])
  @@index([level])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}
