# Local PostgreSQL used by the Next.js API on the production VPS
DATABASE_URL=postgresql://fresh_greens:change-me@127.0.0.1:5432/fresh_greens
DIRECT_DATABASE_URL=postgresql://fresh_greens:change-me@127.0.0.1:5432/fresh_greens

# Optional Supabase services used by payment and webhook functions
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-business-account-id
WHATSAPP_ACCESS_TOKEN=replace-with-access-token
WHATSAPP_VERIFY_TOKEN=replace-with-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# AI bot
MISTRAL_API_KEY=replace-with-mistral-api-key

# Payment providers, if enabled
GEIDEA_MERCHANT_PUBLIC_KEY=replace-with-geidea-public-key
GEIDEA_API_PASSWORD=replace-with-geidea-api-password
GEIDEA_API_URL=https://api-sandbox.merchant.geidea.net
TAMARA_API_TOKEN=replace-with-tamara-token
TAMARA_API_URL=https://api-sandbox.tamara.co
HYPERPAY_URL=https://test.oppwa.com
HYPERPAY_ACCESS_TOKEN=replace-with-hyperpay-token
HYPERPAY_ENTITY_ID=replace-with-hyperpay-entity-id# ─── Database (Supabase-hosted PostgreSQL) ───────────────────────────
# Direct connection (port 5432) — use with PM2 in fork mode (single instance)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Pooled connection (port 6543) — only if switching to PM2 cluster mode
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
# Direct URL for prisma migrate (bypasses connection pooler)
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL="https://yourdomain.com"

# ─── WhatsApp Business API ───────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=fresh_greens_verify

# ─── Mistral AI ──────────────────────────────────────────────────────
MISTRAL_API_KEY=

# ─── Payment: HyperPay ───────────────────────────────────────────────
HYPERPAY_URL="https://oppwa.com"
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
HYPERPAY_WEBHOOK_URL="https://yourdomain.com/api/webhooks/hyperpay"

# ─── Payment: Geidea ─────────────────────────────────────────────────
GEIDEA_MERCHANT_PUBLIC_KEY=
GEIDEA_API_PASSWORD=
GEIDEA_API_URL="https://api.merchant.geidea.net"
GEIDEA_WEBHOOK_URL="https://yourdomain.com/api/webhooks/geidea"
GEIDEA_RETURN_URL="https://yourdomain.com/menu"

# ─── Payment: Tamara ─────────────────────────────────────────────────
TAMARA_API_TOKEN=
TAMARA_API_URL="https://api.tamara.co"
TAMARA_WEBHOOK_URL="https://yourdomain.com/api/webhooks/tamara"
TAMARA_RETURN_URL="https://yourdomain.com/menu"
TAMARA_CANCEL_URL="https://yourdomain.com/menu"
