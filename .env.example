# Application
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Salla
# Public storefront URL opened by the dashboard View Menu button
NEXT_PUBLIC_SALLA_STOREFRONT_URL=https://your-store.salla.sa
SALLA_CLIENT_ID=placeholder-salla-client-id
SALLA_CLIENT_SECRET=placeholder-salla-client-secret
SALLA_API_URL=https://api.salla.dev
SALLA_TOKEN_URL=https://accounts.salla.sa/oauth2/token
SALLA_SCOPES=*
SALLA_TOKEN_ENCRYPTION_KEY=placeholder-32-byte-encryption-key
SALLA_WEBHOOK_SECRET=placeholder-salla-webhook-secret
SALLA_WEBHOOK_URL=https://your-domain.example/api/webhooks/salla

# WhatsApp Business / Meta
WHATSAPP_PHONE_NUMBER_ID=placeholder-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder-business-account-id
WHATSAPP_ACCESS_TOKEN=placeholder-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=placeholder-whatsapp-verify-token
WHATSAPP_APP_SECRET=placeholder-meta-app-secret

# Shared payment webhook authentication
PAYMENT_WEBHOOK_SECRET=placeholder-payment-webhook-secret

# HyperPay
HYPERPAY_URL=https://test.oppwa.com
HYPERPAY_ACCESS_TOKEN=placeholder-hyperpay-access-token
HYPERPAY_ENTITY_ID=placeholder-hyperpay-entity-id
HYPERPAY_WEBHOOK_URL=https://your-domain.example/api/webhooks/payment

# Geidea
GEIDEA_MERCHANT_PUBLIC_KEY=placeholder-geidea-public-key
GEIDEA_API_PASSWORD=placeholder-geidea-api-password
GEIDEA_API_URL=https://api-sandbox.merchant.geidea.net
GEIDEA_WEBHOOK_URL=https://your-domain.example/api/webhooks/payment
GEIDEA_RETURN_URL=https://your-domain.example/menu

# Tamara
TAMARA_API_TOKEN=placeholder-tamara-api-token
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_WEBHOOK_URL=https://your-domain.example/api/webhooks/payment
TAMARA_RETURN_URL=https://your-domain.example/menu
TAMARA_CANCEL_URL=https://your-domain.example/menu

# Optional services
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-supabase-service-role-key
MISTRAL_API_KEY=placeholder-mistral-api-key
